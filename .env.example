# Copy to .env. With either key missing the app runs in demo mode (no spend).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Protect the app when it is online (leave empty for local use)
APP_PASSWORD=
# SESSION_SECRET=   # optional; derived from APP_PASSWORD when empty

# Spend guards (reset daily at midnight UTC)
DAILY_IMAGE_CAP=60
DAILY_CLAUDE_CAP=300
RATE_PER_MIN=20
# With real keys and no APP_PASSWORD the server only listens on this computer (127.0.0.1).
# HOST=0.0.0.0

# Models (defaults shown)
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium        # low | medium | high
# CHECK_MODEL=claude-haiku-5-5
# IMAGE_MODEL_EDIT=gpt-image-2.5-sunburst
# IMAGE_MODEL_FAST=gpt-image-2.5-flare
# IMAGE_QUALITY=medium        # low | medium | high
# TRANSCRIBE_MODEL=gpt-transcribe

# Storage + server
# DATA_DIR=./data
# PORT=5180
